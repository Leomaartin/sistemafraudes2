generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id            Int       @id @default(autoincrement())
  nroUsuario    String
  nombre        String
  domicilio     String?
  ruta          String?
  observaciones String?
  maps          String?
  medidor       String?
  latitud       Float?
  longitud      Float?
  fechaVto      DateTime?
  idEstado      Int?
  idTarifa      Int?
  imagenes      Imagen[]   

  esDepartamento Boolean   @default(false)
  idEstadoDepto  Int?
  paraCorte      Boolean   @default(false)

  rubroComercio  String?
  idRubro        Int?
  nombreComercio String?

  cuadrillas    Cuadrilla[]
  estado        Estado?    @relation("EstadoUsuario", fields: [idEstado], references: [id])
  estadoDepto   Estado?    @relation("EstadoDepto", fields: [idEstadoDepto], references: [id])
  tarifa        Tarifa?    @relation(fields: [idTarifa], references: [id])
  rubro         Rubro?     @relation(fields: [idRubro], references: [id])
}

model Rubro {
  id       Int       @id @default(autoincrement())
  nombre   String    @unique
  usuarios Usuario[]
}

model Cuadrilla {
  id       Int       @id @default(autoincrement())
  nombre   String
  usuarios Usuario[]
}

model Estado {
  id            Int       @id @default(autoincrement())
  nombre        String
  usuarios      Usuario[] @relation("EstadoUsuario")
  usuariosDepto Usuario[] @relation("EstadoDepto")
}

model Tarifa {
  id       Int       @id @default(autoincrement())
  nombre   String
  usuarios Usuario[]
}
model UsuarioSistema {
  id       Int       @id @default(autoincrement())
  usuario  String    @unique
  password String?
  nombre   String
  email    String?   @unique
  rol      String    @default("operador")
  esAdmin  Boolean   @default(false)
  fechaVto DateTime?
  activo   Boolean   @default(true)
}
model Imagen {
  id        Int      @id @default(autoincrement())
  url       String
  usuarioId Int
  createdAt DateTime @default(now())
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}